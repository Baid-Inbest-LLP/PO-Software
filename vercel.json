{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "regions": ["bom1"],
  "buildCommand": "pnpm --filter client build && rm -rf dist && cp -r client/dist dist",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "server/{assets,src/generated}/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js?__poPath=$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
