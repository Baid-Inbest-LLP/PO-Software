{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "regions": ["bom1"],
  "installCommand": "npm install --omit=dev",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{assets,src/generated}/**"
    }
  },
  "routes": [{ "src": "/(.*)", "dest": "/api/index.js" }]
}
